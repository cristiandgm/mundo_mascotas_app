# Copia este archivo como .env.local y completa los valores (NO se sube a Git).
# Reinicia Expo con: npx expo start -c

# Dominio interno de tu tienda Shopify (termina en .myshopify.com)
EXPO_PUBLIC_SHOPIFY_DOMAIN=tu-tienda.myshopify.com

# Token PÚBLICO de la Storefront API (sale del canal Headless / Custom app)
# Nunca pongas aquí el token de Admin API.
EXPO_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=

# Opcional: versión de la API (por defecto 2026-07)
# EXPO_PUBLIC_SHOPIFY_API_VERSION=2026-07
